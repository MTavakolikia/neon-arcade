// ─── Neon Arcade · Database schema ────────────────────────────────────────────
// SQLite for local/preview portability. To move to Postgres: change the datasource
// provider to "postgresql", point DATABASE_URL at the instance, and the enums below
// become native (no other change required — no SQLite-only types are used).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────
// SQLite has no native enum support, so Prisma models these as constrained strings.
// The String values below are the single source of truth for both Prisma and Zod.

enum Role {
  PLAYER
  EDITOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductType {
  DIGITAL
  PHYSICAL
}

enum ProductStatus {
  ACTIVE
  HIDDEN
  SOLD_OUT
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

// ─── Identity ─────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          Role       @default(PLAYER)
  status        UserStatus @default(ACTIVE)
  bio           String?

  // Anonymous arcade players keep their progress in localStorage; this is the
  // optional label they attach to it when signed in.
  callsign      String?    @unique
  xp            Int        @default(0)
  coins         Int        @default(120)
  gamesPlayed   Int        @default(0)
  wins          Int        @default(0)
  bestStreak    Int        @default(0)

  accounts     Account[]
  sessions     Session[]
  posts        Post[]        @relation("PostAuthor")
  orders       Order[]
  achievements UserAchievement[]
  scores       GameScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model Achievement {
  id          String  @id
  name        String
  description String
  emoji       String  @default("🏆")
  coinsReward Int     @default(0)
  xpReward    Int     @default(0)
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  users UserAchievement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserAchievement {
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@index([achievementId])
}

// ─── Blog ─────────────────────────────────────────────────────────────────────

model Post {
  id       String     @id @default(cuid())
  slug     String     @unique
  title    String
  excerpt  String
  body     String
  emoji    String     @default("📝")
  accent   String     @default("#22d3ee")
  coverUrl String?
  tags     String     @default("[]") // JSON string[]
  readMin  Int        @default(5)
  featured Boolean    @default(false)
  status   PostStatus @default(DRAFT)

  authorId String
  author   User   @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([featured])
  @@index([authorId])
}

// ─── Shop ─────────────────────────────────────────────────────────────────────

model CardTheme {
  id        String  @id
  name      String
  emoji     String  @default("🎨")
  css       String
  glow      String  @default("rgba(232,121,249,0.55)")
  price     Int     @default(0)
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String        @id @default(cuid())
  name        String
  description String
  emoji       String        @default("🎁")
  type        ProductType   @default(DIGITAL)
  status      ProductStatus @default(ACTIVE)
  priceCents  Int           @default(0)
  coinPrice   Int?
  tag         String?
  featured    Boolean       @default(false)
  stock       Int?
  sortOrder   Int           @default(0)

  // Digital top-ups grant coins instead of unlocking a theme.
  coinGrant Int @default(0)

  // Physical goods need a shipping price; null = free shipping.
  shippingCents Int @default(0)

  themeId String?
  theme   CardTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
  @@index([themeId])
  @@index([featured])
}

// ─── Commerce ─────────────────────────────────────────────────────────────────

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  status        OrderStatus @default(PENDING)
  // Orders may be placed by guests (no userId) — the arcade allows demo checkouts.
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email         String?
  customerName  String?
  subtotalCents Int         @default(0)
  shippingCents Int         @default(0)
  totalCents    Int         @default(0)
  currency      String      @default("USD")
  notes         String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  productName   String
  productEmoji  String  @default("🎁")
  quantity      Int     @default(1)
  unitCents     Int     @default(0)
  unitCoinPrice Int?
  lineCents     Int     @default(0)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

// ─── Play telemetry (anonymous players included) ──────────────────────────────

model GameScore {
  id         String  @id @default(cuid())
  gameId     String
  difficulty String
  score      Int
  stars      Int?
  won        Boolean @default(false)
  xpEarned   Int     @default(0)
  coinsEarned Int    @default(0)
  durationMs Int?
  // Null userId = anonymous session; the client sends an install id.
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionKey String?

  createdAt DateTime @default(now())

  @@index([gameId, difficulty, score])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// ─── Auth.js ──────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
